/-!
## Exercise 0.1

Use {name}`Nat.card_congr` to turn the bijection into an equality of cardinalities.
Then use {name}`Nat.card_prod` to rewrite the cardinality of the product type.
-/

lemma card_eq_cosets_mul_subgroup [Finite G] :
    Nat.card G = Nat.card (G ⧸ H) * Nat.card H := by
  have e : G ≃ (G ⧸ H) × H := Subgroup.groupEquivQuotientProdSubgroup
  calc
    Nat.card G = Nat.card ((G ⧸ H) × H) := by sorry
    _ = Nat.card (G ⧸ H) * Nat.card H := by sorry

NewTheorem card_eq_cosets_mul_subgroup

