/-!
# Orders of elements

Recall that if $`g` is an element of a group $`G`, then the order of $`g` (where it is defined) is the
smallest positive integer $`n` such that $`g ^ n = 1` (where I use $`1` to denote the identity
element in the group).

In Mathlib, if there is no positive integer $`n` such that $`g ^ n = 1`, then the order of $`n` is
defined to be $`0`.

The order of `g` is denoted `orderOf g` in Mathlib.
-/

namespace cx_2026

variable {G : Type*} [Group G] {x y z : G}

/-!
For example, the order of the identity element is $`1`. This result is called {name}`orderOf_one` in
Mathlib.
-/

example : orderOf 1 = 1 := by
  rw [orderOf_one]

public section

example (n d : Nat) (h : d ∣ n) : orderOf x = d → x ^ d = 1 := by
  intro h
  rw [← h]
  rw [pow_orderOf_eq_one]
  done

