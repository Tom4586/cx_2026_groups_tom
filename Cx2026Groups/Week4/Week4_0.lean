/-!
# Left cosets and the partition

Fix a subgroup $`H` of a group $`G`. The left coset $`gH` is the set of elements
$`gh` with $`h\in H`. Lean writes this as `g • (H : Set G)`. The type annotation
tells Lean to treat the subgroup as a set. The word *left* refers to where we
put the translating element $`g`.

In the integers modulo 12, translating the subgroup from Week 3 gives these sets.

* $`0+H=\{0,3,6,9\}`
* $`1+H=\{1,4,7,10\}`
* $`2+H=\{2,5,8,11\}`

Which of these sets is $`8+H`? Each residue belongs to exactly one of the three
sets. We will prove the corresponding statement for every group and subgroup.
-/

def extended_euclid (a b : ℕ) : ℕ × ℤ × ℤ :=
  if _h : b = 0 then
    (a, 1, 0)
  else
    let (d, s, t) := extended_euclid b (a % b)
    (d, t, (s - (a / b) * t))
  termination_by b
  decreasing_by
  apply Nat.mod_lt
  exact Nat.ne_zero_iff_zero_lt.mp _h

def euclid (a b : ℕ) :=
  if h : b = 0 then a else euclid b (a % b)
  termination_by b 
  decreasing_by
  apply Nat.mod_lt
  exact Nat.ne_zero_iff_zero_lt.mp h

lemma euclid_eq_euclid_mod_of_ne_zero (a b : ℕ) (h : b ≠ 0) : euclid a b = euclid b (a % b) := by
  conv_lhs =>
    unfold euclid
  simp [h]
  done

lemma euclid_zero_eq (a : ℕ) : euclid a 0 = a := by
  unfold euclid
  exact ite_eq_left rfl

example (a b : ℕ) : euclid a b ∣ a ∧ euclid a b ∣ b := by
  induction b using Nat.strong_induction_on generalizing a with
  | h b ih =>
  by_cases hb : b = 0
  · subst hb 
    rw [euclid_zero_eq]
    simp
  · rw [euclid_eq_euclid_mod_of_ne_zero _ _ hb]
    have rem_lt : a % b < b := by
      refine Nat.mod_lt a ?_
      exact Nat.ne_zero_iff_zero_lt.mp hb
    specialize ih (a % b) rem_lt b
    have h3 : b * (a / b) + a % b = a := Nat.div_add_mod a b  
    rcases ih with ⟨midb, midr⟩ 
    constructor
    · nth_rewrite 2 [←h3]
      apply dvd_add
      · exact Nat.dvd_mul_right_of_dvd midb (a / b)
      exact midr 
    exact midb
  done

