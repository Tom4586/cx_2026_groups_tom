import Lean
import Lake.Build.Module
import Lake.Build.Run
import Lake.Load.Workspace
import Lake.Toml

/-!
# Course exporter

Run with `lake exe generateStudent` from the project root. The `[student]` TOML
table selects the source and destination modules, released modules, and import
exclusions. It can also request a generated Verso configuration. Check all
inputs before updating the checked-in outputs.

Use the original syntax spans for deletions and import renames. This preserves
Lean formatting and Verso prose, including comments between commands.
-/

open Lean System Lake.Toml

private def defaultConfig : FilePath := "literate-teacher.toml"
private def generatedHeader := "-- Generated by lake exe generateStudent. Edit the Teacher source.\n"

private structure ExportConfig where
  path : FilePath
  teacherRoot : Name
  studentRoot : Name
  excludedImports : Array Name
  siteConfig : Option FilePath

private def studentName (config : ExportConfig) (name : Name) : Name :=
  name.replacePrefix config.teacherRoot config.studentRoot

private def moduleStem (name : Name) : FilePath :=
  FilePath.mk ("/".intercalate (name.components.map (·.getString!)))

private def modulePath (name : Name) : FilePath :=
  (moduleStem name).addExtension "lean"

private def leanSources (root : Name) : IO (Array FilePath) := do
  let dir := moduleStem root
  let rootFile := modulePath root
  let files ← if ← dir.isDir then dir.walkDir else pure #[]
  let files ← files.filterM fun file =>
    return file.extension == some "lean" && (← file.metadata).type == .file
  let files := files.qsort (fun a b => a.toString < b.toString)
  return if ← rootFile.pathExists then #[rootFile] ++ files else files

private def moduleName (file : FilePath) : Name :=
  (file.withExtension "").components.foldl Name.str .anonymous

/-- Keep the copyright notice first so Mathlib's header linter can read it. -/
private def splitCopyright (source : String) : String × String :=
  if source.startsWith "/-\nCopyright (c) " then
    match source.splitOn "\n-/\n" with
    | header :: body :: rest => (header ++ "\n-/\n", "\n-/\n".intercalate (body :: rest))
    | _ => ("", source)
  else ("", source)

private def failOnErrors (messages : MessageLog) : IO Unit := do
  if messages.hasErrors then
    let errors ← (messages.toList.filter (·.severity == .error)).mapM (·.toString)
    throw <| IO.userError ("".intercalate errors)

private def readConfig (sourceConfig : FilePath) : IO Table := do
  let input ← IO.FS.readFile sourceConfig
  match ← loadToml (Parser.mkInputContext input sourceConfig.toString) |>.toBaseIO with
  | .ok table => pure table
  | .error messages =>
    failOnErrors messages
    throw <| IO.userError s!"Could not read {sourceConfig}"

private def tableAt (sourceConfig : FilePath) (table : Table) (key : Name) : IO Table := do
  let some (.table _ fields) := table.find? key
    | throw <| IO.userError s!"Expected [{key}] in {sourceConfig}"
  pure fields

private def stringArrayAt (sourceConfig : FilePath) (table : Table) (key : Name) : IO (Array String) := do
  let some (.array _ values) := table.find? key
    | throw <| IO.userError s!"Expected student.{key} in {sourceConfig}"
  values.mapM fun
    | .string _ value => pure value
    | _ => throw <| IO.userError s!"Expected strings in student.{key}"

private def stringAt (path : FilePath) (table : Table) (key : Name) : IO String := do
  let some (.string _ value) := table.find? key
    | throw <| IO.userError s!"Expected a string for student.{key} in {path}"
  return value

private def parseModuleName (path : FilePath) (key : Name) (value : String)
    (parent : Name := .anonymous) : IO Name := do
  let parts := value.splitOn "."
  unless parts.all (fun part => match part.toList with
    | first :: rest => isIdFirst first && rest.all isIdRest
    | [] => false) do
    throw <| IO.userError s!"Invalid module name '{value}' for student.{key} in {path}"
  return parts.foldl Name.str parent

private def readExportConfig (path : FilePath) (settings : Table) : IO ExportConfig := do
  let teacherRoot ← parseModuleName path `teacher_root (← stringAt path settings `teacher_root)
  let studentRoot ← parseModuleName path `student_root (← stringAt path settings `student_root)
  let teacherParts := (moduleStem teacherRoot).components.map String.toLower
  let studentParts := (moduleStem studentRoot).components.map String.toLower
  if teacherParts.isPrefixOf studentParts || studentParts.isPrefixOf teacherParts then
    throw <| IO.userError s!"Teacher and Student module roots must be disjoint in {path}"
  let excludedImports ← if (settings.find? `exclude_imports).isSome then
    (← stringArrayAt path settings `exclude_imports).mapM (parseModuleName path `exclude_imports ·)
  else
    pure #[]
  let siteConfig ← if (settings.find? `site_config).isSome then do
    let output : FilePath := ← stringAt path settings `site_config
    unless output.extension == some "toml" && (← Lake.resolvePath output) != (← Lake.resolvePath path) do
      throw <| IO.userError s!"student.site_config in {path} must name a separate .toml file"
    pure (some output)
  else
    pure none
  return { path, teacherRoot, studentRoot, excludedImports, siteConfig }

private def releasedModules (config : ExportConfig) (settings : Table) (teacherModules : Array Name) :
    IO (Array Name) := do
  if (settings.find? `released_modules).isNone then
    return teacherModules
  let prefixes ← (← stringArrayAt config.path settings `released_modules).mapM fun value =>
    parseModuleName config.path `released_modules value config.teacherRoot
  for root in prefixes do
    unless teacherModules.contains root do
      throw <| IO.userError s!"Released module {root} has no source file"
  return teacherModules.filter fun name =>
    name == config.teacherRoot || prefixes.any (·.isPrefixOf name)

/-- Verso stores a dotted module key as one quoted TOML key. -/
private def moduleKey (name : Name) : Name :=
  Name.mkSimple name.toString

private def projectConfig (config : ExportConfig) (source settings : Table) (released : Array Name)
    (combined : Bool) : IO String := do
  let modules ← tableAt config.path source `modules
  let overviewKey := moduleKey config.studentRoot
  let mut studentModules := Table.empty
  for name in released do
    if name != config.teacherRoot then
      -- A module without an override uses Verso's default title and URL.
      if let some value := modules.find? (moduleKey name) then
        studentModules := RBDict.insert (moduleKey (studentName config name)) value studentModules
  let source := source.filter (fun key _ => key != `student)
  if combined then
    let both := studentModules.items.foldl (fun acc (key, value) => RBDict.insert key value acc) modules
    return s!"# Generated from {config.path}.\n" ++
      ppTable (RBDict.insert `modules (.table .missing both) source)
  let studentOverview ← tableAt config.path modules overviewKey
  let title ← stringAt config.path settings `overview_title
  let hideCommands ← stringArrayAt config.path settings `hide_commands
  let studentOverview := studentOverview.insert `title title
  studentModules := RBDict.insert overviewKey (.table .missing studentOverview) studentModules
  let targets := #[Lake.toToml (Table.empty.insert `library config.studentRoot.toString)]
  let output := source.filter (fun key _ => key != `order)
  let output := RBDict.insert `targets (.array .missing targets) output
  let output := RBDict.insert `modules (.table .missing studentModules) output
  let output := RBDict.insert `hide_commands (Lake.toToml hideCommands) output
  return s!"# Generated by lake exe generateStudent. Edit {config.path}.\n" ++ ppTable output

deriving instance ToJson, FromJson for String.Pos.Raw
deriving instance ToJson, FromJson for Syntax.Range

private structure Edit where
  range : Syntax.Range
  replacement : String := ""
  deriving ToJson, FromJson

private structure Lesson where
  name : Name
  ctx : Parser.InputContext
  header : Elab.HeaderSyntax
  parserState : Parser.ModuleParserState
  headerEdits : Array Edit

private def sourceRange (ctx : Parser.InputContext) (stx : Syntax) : IO Syntax.Range :=
  match stx.getRange? with
  | some span => pure span
  | none => throw <| IO.userError s!"{ctx.fileName}: missing source span"

/--
Delete whole lines for hidden commands, including any trailing line comment.
Keep nearby shared prose and comments. A hidden command must occupy its own
lines so its removal cannot leave a trailing comment or alter another command.
-/
private def deleteCommand (ctx : Parser.InputContext) (stx : Syntax) (collapseGap := false) :
    IO Edit := do
  let span ← sourceRange ctx stx
  let map := ctx.fileMap
  let startLine := map.toPosition span.start
  let endLine := map.toPosition span.stop
  let start := map.positions[startLine.line - 1]!
  let stop := map.positions[endLine.line]?.getD span.stop
  let leading := String.Pos.Raw.extract ctx.inputString start span.start
  let suffix := (String.Pos.Raw.extract ctx.inputString span.stop stop).trimAscii
  unless leading.trimAscii.isEmpty && (suffix.isEmpty || suffix.startsWith "--") do
    throw <| IO.userError s!"{ctx.fileName}:{startLine.line}: put the hidden command on its own lines, with any trailing comment written using --"
  let start :=
    if collapseGap && startLine.line > 1 &&
        (stop.atEnd ctx.inputString || stop.get ctx.inputString == '\n') then
      let previous := map.positions[startLine.line - 2]!
      if (String.Pos.Raw.extract ctx.inputString previous start).trimAscii.isEmpty then previous
      else start
    else start
  pure { range := ⟨start, stop⟩ }

private def importEdits (config : ExportConfig) (ctx : Parser.InputContext)
    (header : Elab.HeaderSyntax) (name : Name) (released : Array Name) : IO (Array Edit) := do
  let `(Parser.Module.header| $[module]? $[prelude]? $imports*) := header
    | throw <| IO.userError s!"{ctx.fileName}: unrecognized module header"
  let mut edits := #[]
  for stx in imports do
    let `(Parser.Module.import| $[public]? $[meta]? import $[all]? $mod:ident) := stx
      | throw <| IO.userError s!"{ctx.fileName}: unrecognized import"
    let imported := mod.getId
    if config.excludedImports.contains imported then
      edits := edits.push (← deleteCommand ctx stx)
    else if config.teacherRoot.isPrefixOf imported then
      if released.contains imported then
        edits := edits.push {
          range := ← sourceRange ctx mod, replacement := (studentName config imported).toString }
      else if name == config.teacherRoot && imported.getPrefix == config.teacherRoot then
        edits := edits.push (← deleteCommand ctx stx)
      else
        throw <| IO.userError s!"{ctx.fileName}: a released lesson imports unreleased module {imported}"
  pure edits

private def readLesson (config : ExportConfig) (file : FilePath) (name : Name)
    (released : Array Name) : IO Lesson := do
  let ctx := Parser.mkInputContext (← IO.FS.readFile file) file.toString
  let (header, parserState, messages) ← Parser.parseHeader ctx
  failOnErrors messages
  let headerEdits ← importEdits config ctx header name released
  return { name, ctx, header, parserState, headerEdits }

private def moduleSetups (lessons : Array Lesson) : IO (FilePath × Array ModuleSetup) := do
  let (elan?, some lean, lake?) ← Lake.findInstall?
    | throw <| IO.userError "Could not locate Lean. Run the exporter with the project's Lean toolchain on PATH."
  unless lean.githash == Lean.githash do
    throw <| IO.userError "The exporter was built with a different Lean toolchain. Run lake build generateStudent."
  let lake := lake?.getD (Lake.LakeInstall.ofLean lean)
  let lakeEnv ← (Lake.Env.compute lake lean elan?).adapt IO.userError
  let (workspace?, log) ← (Lake.loadWorkspace {
    lakeEnv, wsDir := ← IO.Process.getCurrentDir
  }).captureLog
  let some workspace := workspace?
    | throw <| IO.userError s!"Could not load the Lake workspace.\n{log}"
  let setups ← workspace.runBuild (cfg := { out := .stderr, outLv := .error }) do
    let jobs ← lessons.mapM fun lesson => do
      let file := lesson.ctx.fileName
      Lake.setupServerModule file.toString (← Lake.resolvePath file) (some lesson.header.toModuleHeader)
    return Lake.Job.collectArray jobs
  return (lean.sysroot, setups)

private unsafe def commandEdits (lesson : Lesson) (setup : ModuleSetup) : IO (Array Edit) := do
  let { ctx, header, parserState, .. } := lesson
  setup.dynlibs.forM Lean.loadDynlib
  let opts := setup.options.toOptions
  -- Importing resets this flag when it finishes.
  Lean.enableInitializersExecution
  let (env, messages) ← Elab.processHeaderCore header.startPos
    (setup.imports?.getD header.imports) (setup.isModule || header.isModule) opts {} ctx
    (plugins := setup.plugins) (mainModule := setup.name) (package? := setup.package?)
    (arts := setup.importArts) (headerStx? := header)
  failOnErrors messages
  let state ← Elab.IO.processCommands ctx parserState (Elab.Command.mkState env messages opts)
  failOnErrors state.commandState.messages
  let mut edits := #[]
  for stx in state.commands do
    if stx.isOfKind ``Parser.Command.exit then
      throw <| IO.userError s!"{ctx.fileName}: #exit prevents the exporter from checking the rest of the file"
    if stx.isOfKind `teacherOnly then
      edits := edits.push (← deleteCommand ctx stx (collapseGap := true))
    else
      for node in stx.topDown do
        if node.isOfKind `teacherOnly then
          throw <| IO.userError s!"{ctx.fileName}: put teacher_only in at the top level of the lesson"
  pure edits

private def applyEdits (ctx : Parser.InputContext) (edits : Array Edit) : IO String := do
  let mut cursor : String.Pos.Raw := 0
  let mut output := ""
  for edit in edits do
    if edit.range.start < cursor then
      throw <| IO.userError s!"{ctx.fileName}: overlapping source edits"
    output := output ++ String.Pos.Raw.extract ctx.inputString cursor edit.range.start ++ edit.replacement
    cursor := edit.range.stop
  pure (output ++ String.Pos.Raw.extract ctx.inputString cursor ⟨ctx.inputString.utf8ByteSize⟩)

private def exportLesson (config : ExportConfig) (lesson : Lesson) (bodyEdits : Array Edit) :
    IO (FilePath × String) := do
  let output ← applyEdits lesson.ctx (lesson.headerEdits ++ bodyEdits)
  let (copyright, body) := splitCopyright output
  pure (modulePath (studentName config lesson.name), copyright ++ generatedHeader ++ body)

private def cacheFile : FilePath := ".lake/build/student-export.json"

private structure CachedEdits where
  name : Name
  key : Lake.Hash
  edits : Array Edit
  deriving ToJson, FromJson

private def readCache : IO (Array CachedEdits) := do
  try
    let contents ← IO.FS.readFile cacheFile
    return ((Json.parse contents >>= fromJson?).toOption).getD #[]
  catch _ => return #[]

private def writeCache (entries : Array CachedEdits) : IO Unit := do
  let temp := cacheFile.addExtension s!"{← IO.Process.getPID}.tmp"
  try
    IO.FS.createDirAll ".lake/build"
    IO.FS.writeFile temp (toJson entries).compress
    IO.FS.rename temp cacheFile
  catch err =>
    IO.FS.removeFile temp |>.catchExceptions (fun _ => pure ())
    IO.eprintln s!"Could not save student export cache: {err}"

private structure ArtifactHash where
  hash : Lake.Hash
  modified : IO.FS.SystemTime
  size : UInt64

private def artifactDigest (path : FilePath) (metadata : IO.FS.Metadata) : IO Lake.Hash := do
  let sidecar := path.addExtension "hash"
  if let .ok stamp ← sidecar.metadata.toBaseIO then
    if metadata.modified ≤ stamp.modified then
      -- Lake has already checked its build inputs. A rebuilt artifact or refreshed
      -- sidecar changes this fingerprint without reading either file's contents.
      return Lake.Hash.ofHashable (metadata.modified.sec, metadata.modified.nsec, metadata.byteSize,
        stamp.modified.sec, stamp.modified.nsec, stamp.byteSize)
  Lake.computeBinFileHash path

/-- An import resolved outside Lake and the toolchain has no tracked dependency artifacts. -/
private def canCache (libDir : FilePath) (lesson : Lesson) (setup : ModuleSetup) : IO Bool := do
  (setup.imports?.getD lesson.header.imports).allM fun imp => do
    if setup.importArts.contains imp.module then return true
    let path ← Lean.findOLean imp.module
    return libDir.components.isPrefixOf path.components

/-- Hash each compiled dependency once per run, even when several lessons import it. -/
private def lessonKey (version : Lake.Hash) (lesson : Lesson) (setup : ModuleSetup)
    (hashes : IO.Ref (Std.HashMap FilePath ArtifactHash)) : IO Lake.Hash := do
  let paths := setup.importArts.toArray.flatMap (fun (_, arts) => arts.toArrays.flatten)
  let paths := paths ++ setup.dynlibs ++ setup.plugins.map (·.path)
  let mut key := version.mix (Lake.Hash.ofString lesson.ctx.inputString)
  key := key.mix (Lake.Hash.ofString (toJson setup).compress)
  for path in paths do
    let info ← match (← hashes.get)[path]? with
      | some info => pure info
      | none => do
        let metadata ← path.metadata
        let digest ← artifactDigest path metadata
        let info : ArtifactHash := { hash := digest, modified := metadata.modified, size := metadata.byteSize }
        hashes.modify (·.insert path info)
        pure info
    key := key.mix info.hash
  return key

private def currentText (path : FilePath) : IO (Option String) := do
  if ← path.pathExists then some <$> IO.FS.readFile path else pure none

private def writeOutputs (config : ExportConfig) (outputs : Array (FilePath × String))
    (lessonCount : Nat) (check : Bool) : IO Unit := do
  let paths := outputs.map Prod.fst
  let stale := (← leanSources config.studentRoot).filter (!paths.contains ·)
  let mut changed := #[]
  for (path, expected) in outputs do
    if (← currentText path) != some expected then
      changed := changed.push (path, expected)
  if check then
    unless changed.isEmpty && stale.isEmpty do
      let files := (changed.map (·.1.toString) ++ stale.map (·.toString)).toList
      let arg := if config.path == defaultConfig then "" else s!" --config {repr config.path.toString}"
      throw <| IO.userError s!"Run lake exe generateStudent{arg} to update these files:\n{String.intercalate "\n" files}"
  else
    -- A lesson removed from the release list must disappear from Verso's source scan.
    for path in stale do
      unless (splitCopyright (← IO.FS.readFile path)).2.startsWith generatedHeader do
        throw <| IO.userError s!"Unexpected Student source {path}. Move it into the Teacher tree or remove it before generating."
    for (path, expected) in changed do
      if let some parent := path.parent then
        IO.FS.createDirAll parent
      IO.FS.writeFile path expected
    stale.forM IO.FS.removeFile
  let site := config.siteConfig.elim "" (fun path => s!" and {path}")
  IO.println s!"Student export {if check then "checked" else "generated"} ({lessonCount} Lean files{site})."

unsafe def main (args : List String) : IO Unit := do
  let (path, args) := match args with
    | "--config" :: file :: rest => (FilePath.mk file, rest)
    | _ => (defaultConfig, args)
  let source ← readConfig path
  let settings ← tableAt path source `student
  let config ← readExportConfig path settings
  let files ← leanSources config.teacherRoot
  let names := files.map moduleName
  unless names.contains config.teacherRoot do
    throw <| IO.userError s!"Missing Teacher root module {config.teacherRoot}"
  let released ← releasedModules config settings names
  if let ["--combined-config", output] := args then
    if (← Lake.resolvePath output) == (← Lake.resolvePath path) then
      throw <| IO.userError "The combined config output must differ from the input config"
    IO.FS.writeFile output (← projectConfig config source settings released true)
    return
  unless args == [] || args == ["--check"] do
    throw <| IO.userError "Usage: lake exe generateStudent [--config FILE] [--check | --combined-config FILE]"
  let mut outputs := #[]
  if let some output := config.siteConfig then
    outputs := outputs.push (output, ← projectConfig config source settings released false)
  let lessons ← (files.zip names).filter (fun (_, name) => released.contains name)
    |>.mapM fun (file, name) => readLesson config file name released
  let (sysroot, setups) ← moduleSetups lessons
  Lean.initSearchPath sysroot
  let libDir ← Lean.getLibDir sysroot
  let executable ← IO.appPath
  let executableMetadata ← executable.metadata
  let version := Lake.Hash.ofString
    s!"{Lean.githash}\n{executable}\n{repr executableMetadata.modified}\n{executableMetadata.byteSize}"
  let hashes ← IO.mkRef ({} : Std.HashMap FilePath ArtifactHash)
  let cached ← readCache
  let mut entries := #[]
  let mut cacheChanged := false
  for (lesson, setup) in lessons.zip setups do
    let edits ← if ← canCache libDir lesson setup then do
      let key ← lessonKey version lesson setup hashes
      let entry ← if let some entry := cached.find? (fun e => e.name == lesson.name && e.key == key) then
        pure entry
      else do
        cacheChanged := true
        pure { name := lesson.name, key, edits := ← commandEdits lesson setup : CachedEdits }
      entries := entries.push entry
      pure entry.edits
    else
      commandEdits lesson setup
    outputs := outputs.push (← exportLesson config lesson edits)
  if cacheChanged || cached.size != entries.size then
    -- Avoid saving validation results if another build replaced artifacts during the export.
    let stable ← (← hashes.get).toArray.allM fun (path, info) => do
      let metadata ← path.metadata
      return metadata.modified == info.modified && metadata.byteSize == info.size
    if stable then writeCache entries
  writeOutputs config outputs lessons.size (args == ["--check"])
